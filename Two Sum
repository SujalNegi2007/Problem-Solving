#First I thought of using for loop twice to access and use diff elements of same list at same time.
#Then I thougth of using i != j to remove cases where i select the same element both time.
#At last I used "if" to add each element to find my target.

class Solution:
    def twoSum(self, nums: List[int], target: int) -> List[int]:
        for i in range(len(nums)):
            for j in range(len(nums)):
                if i != j:
                    if nums[i] + nums[j] == target:
                        return [i,j]
