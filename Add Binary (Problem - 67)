#Given two binary strings a and b, return their sum as a binary string

class Solution:
    def addBinary(self, a: str, b: str) -> str:
        def binary_to_number(number):
            x = list(number)
            len_x = len(x)
            ans = 0
            for num in x:
                if num == "1":
                    ans += 2 ** (len_x - 1)
                len_x -= 1
            return ans
        sum = binary_to_number(a) + binary_to_number(b)
        ans = []
        if sum == 0:
            return "0"
        while True:
            if sum % 2 == 0:
                ans.append("0")
            elif sum % 2 == 1:
                ans.append("1")
            sum = sum // 2
            if sum == 0:
                ans.reverse()
                return "".join(ans)
